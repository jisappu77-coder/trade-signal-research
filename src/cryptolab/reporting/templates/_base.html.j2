<!doctype html>
<html lang="en" data-theme-default>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}cryptolab{% endblock %}</title>
<style>
  {{ css_vars }}
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0; background: var(--plane); color: var(--ink);
    font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 32px 20px 72px; }
  a { color: var(--series-1); }
  h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 15px; margin: 36px 0 12px; color: var(--ink);
       text-transform: uppercase; letter-spacing: 0.06em; font-weight: 650; }
  .sub { color: var(--ink-2); font-size: 13px; margin: 0; }
  .card { background: var(--surface); border: 1px solid var(--grid);
          border-radius: 10px; padding: 18px 20px; }
  .topbar { display: flex; justify-content: space-between; align-items: flex-start;
            gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .theme-toggle { background: var(--surface); color: var(--ink-2); border: 1px solid var(--grid);
                  border-radius: 7px; padding: 6px 11px; font-size: 12px; cursor: pointer; }
  .theme-toggle:hover { color: var(--ink); }

  /* Verdict — status colour never carries meaning alone: icon + word always accompany it. */
  .verdict { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px;
             border-radius: 10px; border: 1px solid var(--grid); background: var(--surface);
             border-left: 4px solid var(--vc); }
  .verdict-icon { width: 22px; height: 22px; flex: none; border-radius: 50%; color: #fff;
                  background: var(--vc); display: grid; place-items: center;
                  font-size: 13px; font-weight: 700; }
  .verdict-word { font-weight: 700; letter-spacing: 0.04em; color: var(--ink); }
  .verdict-text { font-size: 13px; color: var(--ink-2); margin-top: 2px; }
  [data-state="validated"] { --vc: var(--status-good); }
  [data-state="candidate"] { --vc: var(--status-warning); }
  [data-state="killed"]    { --vc: var(--status-critical); }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
           gap: 10px; margin: 16px 0 0; }
  .stat { background: var(--surface); border: 1px solid var(--grid);
          border-radius: 9px; padding: 12px 14px; }
  .stat-k { font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase;
            color: var(--muted); }
  .stat-v { font-size: 21px; font-weight: 620; margin-top: 3px;
            font-variant-numeric: tabular-nums; }
  .stat-n { font-size: 11.5px; color: var(--ink-2); margin-top: 2px; }

  pre.header-block { background: var(--surface); border: 1px solid var(--grid);
    border-radius: 9px; padding: 16px; overflow-x: auto; font-size: 12.5px; line-height: 1.6;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--ink); }

  table { width: 100%; border-collapse: collapse; font-size: 13.5px;
          font-variant-numeric: tabular-nums; }
  th { text-align: left; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
       color: var(--muted); font-weight: 600; padding: 8px 10px;
       border-bottom: 1px solid var(--axis); white-space: nowrap; }
  td { padding: 9px 10px; border-bottom: 1px solid var(--grid); }
  tbody tr:hover { background: color-mix(in oklab, var(--series-1) 7%, transparent); }
  .num { text-align: right; }
  .scroll { overflow-x: auto; border: 1px solid var(--grid); border-radius: 9px;
            background: var(--surface); }

  /* Charts. Every mark reads a token, so a theme swap repaints without new markup. */
  .chart { width: 100%; height: auto; display: block; }
  .grid { stroke: var(--grid); stroke-width: 1; }
  .axis { stroke: var(--axis); stroke-width: 1; }
  .reference { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 3; }
  .reference-label, .tick { fill: var(--muted); font-size: 10.5px;
                            font-family: ui-monospace, Menlo, monospace; }
  .series-label { fill: var(--ink-2); font-size: 11px; font-weight: 600; }
  .bar-value { fill: var(--ink-2); font-size: 10.5px;
               font-family: ui-monospace, Menlo, monospace; }
  .bar-fill { fill: var(--series-1); }
  .bar-fill.emphasis { stroke: var(--ink); stroke-width: 1.5; }
  .hover-band { fill: transparent; }
  .hover-band:hover { fill: color-mix(in oklab, var(--series-1) 12%, transparent); }

  .meter { position: relative; display: inline-block; width: 92px; height: 7px;
           background: var(--mid); border-radius: 4px; vertical-align: middle; }
  .meter-fill { position: absolute; inset: 0 auto 0 0; border-radius: 4px; }
  .meter-fill[data-state="good"] { background: var(--status-good); }
  .meter-fill[data-state="critical"] { background: var(--status-critical); }
  .meter-gate { position: absolute; top: -2px; width: 2px; height: 11px;
                background: var(--ink-2); border-radius: 1px; }
  .pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px;
          font-weight: 600; padding: 2px 8px; border-radius: 999px;
          border: 1px solid var(--vc); color: var(--ink); }
  .pill i { width: 7px; height: 7px; border-radius: 50%; background: var(--vc);
            font-style: normal; }
  .note { font-size: 12.5px; color: var(--ink-2); }
  .caption { font-size: 12px; color: var(--ink-2); margin: 6px 2px 0; }
  footer { margin-top: 48px; padding-top: 18px; border-top: 1px solid var(--grid);
           font-size: 12px; color: var(--muted); }
  @media (max-width: 640px) { .wrap { padding: 20px 14px 48px; } h1 { font-size: 19px; } }
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div>{% block heading %}{% endblock %}</div>
    <button class="theme-toggle" id="tt" type="button">Theme</button>
  </div>
  {% block body %}{% endblock %}
  <footer>{% block foot %}{% endblock %}</footer>
</div>
<script>
  (function () {
    var root = document.documentElement, key = "cryptolab-theme";
    try { var s = localStorage.getItem(key); if (s) root.setAttribute("data-theme", s); } catch (e) {}
    document.getElementById("tt").addEventListener("click", function () {
      var dark = root.getAttribute("data-theme") === "dark"
        || (!root.hasAttribute("data-theme")
            && matchMedia("(prefers-color-scheme: dark)").matches);
      var next = dark ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem(key, next); } catch (e) {}
    });
  })();
</script>
</body>
</html>
